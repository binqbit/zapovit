# Generate a private .env with random keys: zapovit generate-env --output .env
# Then set TELEGRAM_BOT_TOKEN below. See docs/operations.md for Docker setup.
# .env is read by Docker Compose; the Rust binary reads exported environment.

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# This build accepts synthetic data only.
DATA_MODE=synthetic

# Generated together. Keep the URL password and DATABASE_PASSWORD in sync.
DATABASE_URL=
DATABASE_PASSWORD=

# Versioned encryption keyrings; generated as single-line JSON automatically.
# Retain old key IDs when rotating keys used by existing data.
KEK_KEYRING=
VERIFIER_KEYRING=
JOURNAL_KEYRING=

# Optional native durable replica directory; ordinary Compose uses its own path.
# For Compose use: -f compose.yaml -f compose.replica.yaml and set
# JOURNAL_REPLICA_PATH to a writable independently durable mount on the host.
# A second directory/volume on the same host does not protect against host loss.
JOURNAL_REPLICA_DIR=

# Generated S3 credentials and Garage node/admin secrets.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Delivery workers: 1-4. PostgreSQL connection pool: 2-20.
WORKERS=4
DATABASE_POOL=10

# Container identity; persistent journal ownership must match.
APP_UID=10001
APP_GID=10001

# Compose uses internal Garage addresses, region garage and bucket zapovit.
# Health listens on container port 8080; no host ports are published.
